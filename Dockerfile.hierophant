# Retrieve a specified image for building.
ARG BUILD_IMAGE=unattended/petros:latest

# Retrieve a specified image for final container runtime.
ARG RUNTIME_IMAGE=debian:trixie-slim@sha256:66b37a5078a77098bfc80175fb5eb881a3196809242fd295b25502854e12cbec

# Build from the base image.
FROM ${BUILD_IMAGE} AS builder

# Build type: "source" (default) or "prebuilt" (CI)
ARG BUILD_TYPE=source

# BuildKit cache-mount namespace for the source build's cargo state; shares
# ids with Dockerfile.contemplant (same workspace) so either build warms the
# other. See the contemplant Dockerfile for the full rationale and the
# pristine-release toggle (DOCKER_BUILD_CACHE=0).
ARG BUILD_CACHE_ID=shared

# The `VENDOR_BASE_URL` specifies where to download vendored dependencies.
ARG VENDOR_BASE_URL
RUN test -n "${VENDOR_BASE_URL}" || ( \
  echo "ERROR: VENDOR_BASE_URL build argument is required!" >&2 \
  && exit 1)
ENV VENDOR_BASE_URL=${VENDOR_BASE_URL}

# Circuit version to use (matches SP1 SDK version).
ARG SP1_CIRCUITS_VERSION
RUN test -n "${SP1_CIRCUITS_VERSION}" || ( \
  echo "ERROR: SP1_CIRCUITS_VERSION build argument is required!" >&2 \
  && exit 1)
ENV SP1_CIRCUITS_VERSION=${SP1_CIRCUITS_VERSION}

# Tag of the vendored bare-mirror tarballs for the OpenVM git dependencies;
# see Dockerfile.contemplant for the full rationale (checksummed CDN mirrors
# + cargo's lockfile SHA check replace ad-hoc github fetches).
ARG OPENVM_GIT_VERSION
RUN test -n "${OPENVM_GIT_VERSION}" || ( \
  echo "ERROR: OPENVM_GIT_VERSION build argument is required!" >&2 \
  && exit 1)
ENV OPENVM_GIT_VERSION=${OPENVM_GIT_VERSION}

# Version tag of the vendored openvm-agg-keys tarball. OPTIONAL: empty skips
# staging. Hierophant wants internal_recursive.pk just like workers do - its
# stark-mode verification assembles the same aggregation key stack - and
# falls back to slow in-process keygen without it.
ARG OPENVM_AGG_KEYS_VERSION=

# Download the vendored SP1 circuit files FIRST, before the cargo build.
# Placing vendoring above the source COPY + compile means docker's layer
# cache holds the 2.5 GB of circuit artifacts across routine source edits ;
# only a prover/ or vendor.sh change (or a vendor-arg bump) re-downloads.
# Remote: ${VENDOR_BASE_URL}/sp1/${SP1_CIRCUITS_VERSION}/{groth16,plonk}.tar.gz
WORKDIR /tmp
COPY container/vendor.sh /tmp/vendor.sh
COPY provers/ /tmp/provers/
RUN --mount=type=cache,id=hierophant-vendor-${BUILD_CACHE_ID},target=/vendor-cache,sharing=locked,uid=10001,gid=10001 \
  export VENDOR_CACHE_DIR=/vendor-cache && \
  /tmp/vendor.sh "groth16.tar.gz" "provers/sp1/${SP1_CIRCUITS_VERSION}" "sp1/${SP1_CIRCUITS_VERSION}/" && \
  /tmp/vendor.sh "plonk.tar.gz" "provers/sp1/${SP1_CIRCUITS_VERSION}" "sp1/${SP1_CIRCUITS_VERSION}/"
RUN mkdir -p /home/petros/.sp1/circuits/groth16/${SP1_CIRCUITS_VERSION} && \
  mkdir -p /home/petros/.sp1/circuits/plonk/${SP1_CIRCUITS_VERSION} && \
  cp -r /tmp/extracted-groth16/${SP1_CIRCUITS_VERSION}/* /home/petros/.sp1/circuits/groth16/${SP1_CIRCUITS_VERSION}/ && \
  cp -r /tmp/extracted-plonk/${SP1_CIRCUITS_VERSION}/* /home/petros/.sp1/circuits/plonk/${SP1_CIRCUITS_VERSION}/ && \
  touch /home/petros/.sp1/circuits/groth16/.download_complete && \
  touch /home/petros/.sp1/circuits/plonk/.download_complete

# Vendored bare mirrors of the OpenVM git dependencies + the fetch rewrite
# pointing cargo at them. Mirror of the Dockerfile.contemplant arrangement;
# see the comment there for why git-fetch-with-cli lives in the cargo config
# FILE rather than the env var.
RUN --mount=type=cache,id=hierophant-vendor-${BUILD_CACHE_ID},target=/vendor-cache,sharing=locked,uid=10001,gid=10001 \
  export VENDOR_CACHE_DIR=/vendor-cache && \
  /tmp/vendor.sh "openvm-git-mirror.tar.gz" \
    "provers/openvm/git/${OPENVM_GIT_VERSION}" \
    "openvm/git/${OPENVM_GIT_VERSION}/" && \
  /tmp/vendor.sh "stark-backend-git-mirror.tar.gz" \
    "provers/openvm/git/${OPENVM_GIT_VERSION}" \
    "openvm/git/${OPENVM_GIT_VERSION}/" && \
  mkdir -p /home/petros/vendor-git && \
  mv /tmp/extracted-openvm-git-mirror/openvm.git /home/petros/vendor-git/openvm.git && \
  mv /tmp/extracted-stark-backend-git-mirror/stark-backend.git /home/petros/vendor-git/stark-backend.git && \
  git config --global \
    url."file:///home/petros/vendor-git/openvm.git".insteadOf \
    "https://github.com/openvm-org/openvm.git" && \
  git config --global \
    url."file:///home/petros/vendor-git/stark-backend.git".insteadOf \
    "https://github.com/openvm-org/stark-backend.git" && \
  mkdir -p "${CARGO_HOME:-$HOME/.cargo}" && \
  printf '[net]\ngit-fetch-with-cli = true\n' \
    >> "${CARGO_HOME:-$HOME/.cargo}/config.toml"

# Stage the vendored OpenVM aggregation keys when a version is pinned.
RUN --mount=type=cache,id=hierophant-vendor-${BUILD_CACHE_ID},target=/vendor-cache,sharing=locked,uid=10001,gid=10001 \
  export VENDOR_CACHE_DIR=/vendor-cache && \
  if [ -n "${OPENVM_AGG_KEYS_VERSION}" ]; then \
    /tmp/vendor.sh "openvm-agg-keys.tar.gz" \
      "provers/openvm/halo2/${OPENVM_AGG_KEYS_VERSION}" \
      "openvm/halo2/${OPENVM_AGG_KEYS_VERSION}/" && \
    mkdir -p /home/petros/.openvm && \
    cp -r /tmp/extracted-openvm-agg-keys/* /home/petros/.openvm/; \
  else \
    echo "OPENVM_AGG_KEYS_VERSION empty; skipping OpenVM aggregation-key staging" && \
    mkdir -p /home/petros/.openvm; \
  fi

# Prepare the build image. COPY only the workspace members that cargo
# actually resolves (see Cargo.toml's `[workspace] members = [...]`). The
# test-client crates under src/sp1-fibonacci/ and src/risc0-fibonacci/ are
# excluded from the workspace and are irrelevant to building the
# hierophant binary; copying them in would make any test-client edit
# invalidate this layer and every layer below it. Cargo still requires
# every workspace member directory to exist at resolution time, so all
# of them must be present even when the hierophant binary doesn't
# transitively depend on every member (e.g. `src/fibonacci` is consumed
# only by the integration-test guests / hosts but is listed as a member
# to keep it in the repo's one workspace lockfile).
WORKDIR /build
# .cargo/config.toml carries the --allow-multiple-definition link flag that
# resolves the risc0-platform/openvm-platform `sys_alloc_aligned` collision;
# without it the binary link fails (or worse, succeeds by section-order
# luck). Host and CI builds pick it up from the checkout automatically -
# the in-container build only sees what is COPY'd.
COPY .cargo/ .cargo/
COPY Cargo.toml Cargo.lock ./
COPY src/hierophant/ src/hierophant/
COPY src/contemplant/ src/contemplant/
COPY src/network-lib/ src/network-lib/
COPY src/fibonacci/ src/fibonacci/
COPY src/openvm-worker-proto/ src/openvm-worker-proto/
# The openvm-worker is its own excluded workspace (the openvm-sdk
# quarantine; see the root Cargo.toml note); the hierophant spawns it
# for stark-mode proof verification.
COPY src/openvm-worker/ src/openvm-worker/

# Conditionally build from source or use a pre-built binary. Cache mounts
# per the contemplant Dockerfile's build step; ids intentionally identical.
COPY out/ /build/out/
RUN --mount=type=cache,id=hierophant-cargo-registry-${BUILD_CACHE_ID},target=/home/petros/.cargo/registry,uid=10001,gid=10001 \
  --mount=type=cache,id=hierophant-cargo-git-${BUILD_CACHE_ID},target=/home/petros/.cargo/git,uid=10001,gid=10001 \
  --mount=type=cache,id=hierophant-target-${BUILD_CACHE_ID},target=/build/target,uid=10001,gid=10001 \
  --mount=type=cache,id=hierophant-openvm-worker-target-${BUILD_CACHE_ID},target=/build/worker-target,uid=10001,gid=10001 \
  if [ "$BUILD_TYPE" = "prebuilt" ]; then \
  echo "Using pre-built binary from ./out/hierophant"; \
  test -f /build/out/hierophant || (echo "ERROR: BUILD_TYPE=prebuilt but no binary found in ./out/hierophant" >&2 && exit 1); \
  cp /build/out/hierophant /build/hierophant-binary; \
  test -f /build/out/openvm-worker-cpu || (echo "ERROR: BUILD_TYPE=prebuilt but no binary found in ./out/openvm-worker-cpu (the CUDA-free hierophant verify worker; run make build)" >&2 && exit 1); \
  cp /build/out/openvm-worker-cpu /build/openvm-worker-binary; \
else \
  echo "Building from source ..."; \
  cargo build --release --bin hierophant --locked; \
  cp /build/target/release/hierophant /build/hierophant-binary; \
  echo "Building openvm-worker (verification; CPU, no EVM proving) ..."; \
  CARGO_TARGET_DIR=/build/worker-target cargo build --release \
    --manifest-path src/openvm-worker/Cargo.toml --locked; \
  cp /build/worker-target/release/openvm-worker /build/openvm-worker-binary; \
fi

# Stage the glibc + libgcc /nix/store closure for the SP1 core-executor
# runner embedded in the binary; see the matching RUN in
# Dockerfile.contemplant for the full story. The hierophant only verifies
# today and never spawns the runner, but the bytes are embedded all the
# same, so this keeps the image safe if an execution path ever appears and
# keeps the two images consistent. Store paths are read from the built
# binary, so a petros toolchain bump needs no edit here; prebuilt host
# binaries carry no /nix/store paths and stage an empty closure.
RUN mkdir -p /build/nix-closure/nix/store && \
  RUNPATH="$(readelf -d /build/hierophant-binary | sed -n 's/.*path: \[\(.*\)\]$/\1/p' | tr ':' ' ')" && \
  INTERP="$(readelf -l /build/hierophant-binary | sed -n 's/.*interpreter: \(.*\)]$/\1/p')" && \
  for e in $INTERP $RUNPATH; do \
    p="${e#/nix/store/}"; [ "$p" = "$e" ] && continue; \
    root="/nix/store/${p%%/*}"; \
    case "$root" in *-glibc-*|*-gcc-*) ;; *) continue ;; esac; \
    if [ -d "$root" ] && [ ! -d "/build/nix-closure$root" ]; then \
      cp -a "$root" /build/nix-closure/nix/store/; \
    fi; \
  done && \
  ls /build/nix-closure/nix/store/

# Prepare a runtime container.
FROM ${RUNTIME_IMAGE}

# OCI image labels for metadata and documentation.
LABEL org.opencontainers.image.title="Hierophant"
LABEL org.opencontainers.image.source=https://github.com/unattended-backpack/hierophant
LABEL org.opencontainers.image.description="Prove all things; hold fast that which is good. Hierophant is the master of a self-hosted ZK prover network."
LABEL org.opencontainers.image.vendor="Unattended Backpack, Inc."
LABEL org.opencontainers.image.licenses="LicenseRef-VPL WITH AGPL-3.0-only"

# Copy binaries from builder.
COPY --from=builder /build/hierophant-binary /usr/local/bin/hierophant
# The openvm-sdk quarantine subprocess; the hierophant spawns it for
# stark-mode proof verification (see src/openvm-worker).
COPY --from=builder /build/openvm-worker-binary /usr/local/bin/openvm-worker
ENV OPENVM_WORKER_PATH=/usr/local/bin/openvm-worker

# Nix loader closure for the embedded SP1 core-executor runner (see the
# staging RUN at the end of the builder stage): lands at the exact
# /nix/store paths the runner's interpreter and RUNPATH name. Everything
# else in this image resolves through the Debian loader.
COPY --from=builder /build/nix-closure/ /

# Install runtime dependencies and fix binary interpreter. The RUNPATH
# strip matters once the nix closure above exists: the binary's nix
# RUNPATH entries would otherwise become resolvable and make the Debian
# ld-linux load nix's libc, which crashes on a GLIBC_PRIVATE symbol
# mismatch. All of the binary's own libs resolve via the Debian loader's
# defaults, exactly as they did when the RUNPATH pointed at paths that
# did not exist.
RUN apt-get update && \
  apt-get install -y --no-install-recommends \
    ca-certificates \
    patchelf && \
  chmod +x /usr/local/bin/hierophant /usr/local/bin/openvm-worker && \
  patchelf --set-interpreter /lib64/ld-linux-x86-64.so.2 /usr/local/bin/hierophant && \
  patchelf --remove-rpath /usr/local/bin/hierophant && \
  patchelf --set-interpreter /lib64/ld-linux-x86-64.so.2 /usr/local/bin/openvm-worker && \
  patchelf --remove-rpath /usr/local/bin/openvm-worker && \
  apt-get remove -y patchelf && \
  apt-get autoremove -y && \
  rm -rf /var/lib/apt/lists/*

# Prepare specific non-root user for security. Pre-create (and chown while
# still empty) the parent directories the asset COPYs below land in, so the
# COPYs never need a follow-up recursive chown: on overlayfs, chown -R
# copies up every file it touches, which would duplicate the multi-GB asset
# layers in ownership-metadata form. Ownership is instead set at COPY time
# via --chown, which is also why the assets are copied directly to their
# final ~/.sp1 and ~/.openvm homes rather than staged under /opt and cp'd
# (the old staging arrangement stored every asset byte twice).
RUN useradd --system --create-home --shell /bin/bash hierophant && \
  chown hierophant:hierophant /usr/local/bin/hierophant && \
  mkdir -p /home/hierophant/.sp1 && \
  chown -R hierophant:hierophant /home/hierophant/.sp1

# Vendored circuit artifacts, straight to the hierophant user's home. The
# tree includes the .download_complete markers sp1-sdk checks.
COPY --from=builder --chown=hierophant:hierophant /home/petros/.sp1/circuits /home/hierophant/.sp1/circuits

# Vendored OpenVM aggregation keys (may be an empty directory when
# OPENVM_AGG_KEYS_VERSION was not pinned at build time).
COPY --from=builder --chown=hierophant:hierophant /home/petros/.openvm /home/hierophant/.openvm
USER hierophant
WORKDIR /home/hierophant
ENV RUST_LOG=info RUST_LOG_STYLE=always RUST_BACKTRACE=1
ENTRYPOINT ["/usr/local/bin/hierophant"]
