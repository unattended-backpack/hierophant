# This file is updated by the maintaining team as keys or details change. You
# should not need to manually adjust it. If you wish to override it, there are
# instructions in the README file.

# The name of the Hierophant Docker image.
HIEROPHANT_NAME=hierophant

# The name of the Contemplant Docker image.
CONTEMPLANT_NAME=contemplant

# The image to use for building this project.
BUILD_IMAGE=unattended/petros:latest

# The runtime image to use for the final container.
RUNTIME_IMAGE=debian:trixie-slim@sha256:66b37a5078a77098bfc80175fb5eb881a3196809242fd295b25502854e12cbec

# The URL where large, specifically-vendored binaries are downloaded from.
VENDOR_BASE_URL=https://sigil-attic.nyc3.digitaloceanspaces.com/sigil-tarballs

# The SP1 circuits version to use in the build.
SP1_CIRCUITS_VERSION=v6.1.0

# The sp1-gpu-server release to vendor. Keyed by the sp1-sdk CRATE
# version (sp1-cuda version-checks the server binary against the exact
# SDK version), not by the circuits version above; bump this in lockstep
# with the workspace sp1-sdk pin.
SP1_GPU_SERVER_VERSION=v6.6.0

# The tag of the upstream risc0-groth16-prover docker image whose contents
# were extracted into the vendored risc0-groth16-prover.tar.gz. Pins every
# byte of the Groth16 proving key + gnark prover all the way back to a
# specific upstream release. Bump this when risc0-zkvm is upgraded and the
# new version pins a newer image tag; re-extract and re-upload to
# ${VENDOR_BASE_URL}/risc0/groth16-prover/<new-tag>/risc0-groth16-prover.tar.gz.
RISC0_GROTH16_PROVER_TAG=v2025-04-03.1

# The canonical feature set released contemplant binaries carry, and the
# default for every in-petros docker build (including all test targets, so
# tests validate the release-shaped artifact). One universal binary serves
# every VM and backend; whether CUDA/EVM capability is USED is runtime
# config on each [[provers]] entry. The Makefile and release workflow both
# read this value - there is no second copy to keep in sync.
CONTEMPLANT_RELEASE_FEATURES=enable-native-gnark,enable-risc0-cuda,enable-openvm-cuda,enable-openvm-evm

# The canonical GPU architecture list released images compile CUDA kernels
# for: Ampere (80) through Blackwell (120). Turing (sm_75) is deliberately
# absent: SP1's GPU server refuses cards under 24 GB outright and OpenVM's
# aggregation kernels exceed Turing's per-launch resources, leaving risc0
# as the only VM it fully serves; Turing-class risc0 workers remain
# buildable with an explicit CUDA_ARCH=75. The Makefile and the release
# workflow both read this value (NVCC gencode flags are derived from it),
# so there is no second copy to keep in sync; Dockerfile.contemplant's ARG
# default mirrors it only as a fallback for direct docker invocations.
CUDA_RELEASE_ARCH=80,86,89,90,120

# The tag of the vendored bare-mirror tarballs for the OpenVM git
# dependencies (openvm-org/openvm and openvm-org/stark-backend, both pinned
# at this tag by the workspace Cargo.toml). OpenVM isn't on crates.io, so
# unlike the SP1/RISC Zero crates its source has no registry checksum;
# these mirrors put the bytes on the CDN behind committed sha256s, and
# cargo's lockfile commit-SHA check re-verifies identity at build time.
# Bump in lockstep with the openvm-sdk tag in Cargo.toml; re-mirror and
# re-upload to ${VENDOR_BASE_URL}/openvm/git/<new-tag>/{openvm,stark-backend}-git-mirror.tar.gz.
OPENVM_GIT_VERSION=v2.0.2

# The halo2 line of the vendored openvm-agg-keys tarball (deterministic
# internal-recursive aggregation keys; no trusted setup involved). This is
# the OpenVM minor line the halo2 circuits belong to (for example v2.0),
# not the SDK patch tag: upstream regenerates the keys per minor release
# and holds them stable across patch releases, so a patch bump of
# OPENVM_GIT_VERSION leaves this pin alone. EMPTY skips baking them into
# images: stark-mode proving/verification still works but pays a slow,
# RAM-heavy in-process keygen on first use. Populate after generating via
# petros's src/scripts/generate-openvm-agg-keys.sh, committing the sha256
# under provers/openvm/halo2/<line>/, and uploading the tarball to
# ${VENDOR_BASE_URL}/openvm/halo2/<line>/openvm-agg-keys.tar.gz.
OPENVM_AGG_KEYS_VERSION=v2.0

# The halo2 line of the vendored OpenVM EVM proving assets (the halo2
# proving key tarball at
# ${VENDOR_BASE_URL}/openvm/halo2/<line>/openvm-halo2-pk.tar.gz plus the
# raw kzg_bn254_{10..24}.srs params at
# ${VENDOR_BASE_URL}/openvm/kzg/${OPENVM_KZG_VERSION}/). Keyed by minor
# line exactly like OPENVM_AGG_KEYS_VERSION, since the proving key is
# derived from the same circuits. EMPTY builds lean images; setting it
# bakes ~13.5 GB into the contemplant image's ~/.openvm so EVM-enabled
# workers are fully self-contained (no volume mounts, which rental fleets
# like Vast.ai require). Pair with a contemplant binary built with
# `--features enable-openvm-evm`.
OPENVM_EVM_ASSETS_VERSION=v2.0

# The Perpetual Powers of Tau contribution naming the vendored KZG params
# set on the CDN. Matches petros's OPENVM_KZG_VERSION; only consulted when
# OPENVM_EVM_ASSETS_VERSION is set.
OPENVM_KZG_VERSION=challenge_0085

# The version of the risc0-groth16 rzup component vendored for the CUDA
# Groth16 path. Distinct from RISC0_GROTH16_PROVER_TAG above, which pins the
# CPU-path docker-image-extraction; this one pins the rzup-distributed
# artifact that risc0-groth16-sys's in-process CUDA shrink_wrap reads from
# $HOME/.risc0/extensions/v${VERSION}-risc0-groth16/. Contents are a set of
# Groth16 proving-key / constraint / witness-graph files (fuzzed_msm_results
# .bin, preprocessed_coeffs.bin, stark_verify_final.zkey, stark_verify_graph
# .bin); completely different from the CPU tarball's stark_verify/prover
# binaries. Bump in lockstep with risc0-zkvm / risc0-groth16 crate bumps.
# Mirror the component tarball to
# ${VENDOR_BASE_URL}/risc0/groth16-rzup/<new-version>/risc0-groth16.tar.xz.
RISC0_GROTH16_RZUP_VERSION=v0.1.0
